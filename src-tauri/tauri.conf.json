{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TNLauncher",
  "version": "0.1.0",
  "identifier": "dev.thenofis.tnlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TNLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/modrinth/manifest.json": "plugins/modrinth/manifest.json",
      "../plugins/modrinth/main.js": "plugins/modrinth/main.js",
      "../plugins/curseforge/manifest.json": "plugins/curseforge/manifest.json",
      "../plugins/curseforge/main.js": "plugins/curseforge/main.js",
      "../plugins/elyby/manifest.json": "plugins/elyby/manifest.json",
      "../plugins/elyby/main.js": "plugins/elyby/main.js",
      "../plugins/discord/manifest.json": "plugins/discord/manifest.json",
      "../plugins/discord/main.js": "plugins/discord/main.js"
    }
  }
}
