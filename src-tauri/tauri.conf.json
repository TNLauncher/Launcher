{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TNLauncher",
  "version": "0.2.2",
  "identifier": "dev.thenofis.tnlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TNLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QjEyRkFEMjQzREQ1Q0MKUldUTTFUMGtyUyt4V041UzV5Sm5WVHpSVXplYlZrS3MyK25lUGYreFFYYVpXaVhuYStzWmJBVFEK",
      "endpoints": [
        "https://github.com/TNLauncher/Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
