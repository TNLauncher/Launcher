{
  "id": "sessions",
  "name": "Play sessions",
  "version": "1.0.0",
  "api": 1,
  "description": "Example plugin: logs each game session and shows them on a page and an instance tab.",
  "contributes": {
    "pages": [{ "id": "journal", "title": "Sessions", "icon": "history", "entry": "page.html" }],
    "instanceTabs": [{ "id": "sessions", "title": "Sessions", "icon": "history", "entry": "page.html" }],
    "settings": [{ "key": "keep", "label": "Sessions to keep", "hint": "Older ones are dropped. Empty = 100.", "type": "text" }]
  },
  "permissions": { "instances": true }
}
